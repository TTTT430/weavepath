# Copy this file to .env only if your process manager loads it.
# Never commit real API keys.

# Data storage (optional)
# WEAVEPATH_DATA_DIR=C:\path\to\weavepath-data
# WEAVEPATH_DB=C:\path\to\workspace.db

# OpenAI-compatible model provider
# WEAVEPATH_LLM_BASE_URL=https://api.openai.com/v1
# WEAVEPATH_LLM_MODEL=gpt-5.4
# WEAVEPATH_LLM_API_KEY=
# WEAVEPATH_LLM_TIMEOUT=60
# WEAVEPATH_LLM_SYSTEM_PROMPT=

# Legacy COTHINKER_* variables remain supported for local migration.
