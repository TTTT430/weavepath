{
  "mcpServers": {
    "weavepath-codex-companion": {
      "command": "cmd.exe",
      "args": ["/d", "/s", "/c", "call", "./scripts/launch.cmd"],
      "cwd": ".",
      "env_vars": [
        "CODEX_APP_TOOLS_PIPE_PATH",
        "CODEX_MCP_NODE_PATH",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "CODEX_CLI_PATH",
        "USERPROFILE",
        "LOCALAPPDATA",
        "PATH"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 3600
    }
  }
}
